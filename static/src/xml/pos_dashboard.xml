<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_sales_dashboard.Template">
        <div class="o_pos_dashboard container-fluid" t-attf-class="{{ this.state.dark_mode ? 'dark-mode' : '' }}">

            <!-- ================= TOP HEADER BAR ================= -->
            <div class="dashboard-topbar">
                <div class="topbar-brand">
                    <div class="brand-icon">
                        <i class="oi" data-icon="stacked_bar_chart"/>
                    </div>
                    <div>
                        <h2 class="dashboard-title">POS Sales Dashboard</h2>
                        <div class="dashboard-datetime">
                            <i class="oi" data-icon="schedule"/>
                            <span t-out="this.state.current_datetime"/>
                        </div>
                    </div>
                </div>

                <div class="topbar-actions">
                    <!-- STORE SELECTOR -->
                    <div class="session-filter">
                        <i class="oi session-icon" data-icon="storefront"/>
                        <select class="session-dropdown" t-on-change="(ev) => this.changeConfig(ev)">
                            <option t-att-selected="this.state.selected_config === null" value="">
                                All Stores
                            </option>
                            <t t-foreach="this.state.all_configs" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-att-selected="this.state.selected_config === c.id">
                                    <t t-out="c.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <!-- REFRESH & EXPORT -->
                    <button class="icon-action-btn" title="Refresh Dashboard" t-on-click="() => this.loadDashboard()">
                        <i class="oi" data-icon="autorenew"/>
                    </button>
                    <button class="icon-action-btn" title="Export Top Products CSV" t-on-click="() => this.exportProductsCSV()">
                        <i class="oi" data-icon="download"/>
                    </button>

                    <!-- NOTIFICATIONS -->
                    <div class="notification-wrapper">
                        <button class="icon-action-btn" title="Notifications" t-on-click="() => this.toggleNotifications()">
                            <i class="oi" data-icon="notifications"/>
                            <span class="notification-badge" t-if="this.state.notification_count">
                                <t t-out="this.state.notification_count"/>
                            </span>
                        </button>

                        <div class="notification-dropdown" t-if="this.state.showNotifications">
                            <div class="notification-title">
                                <span>Latest Orders</span>
                                <span class="mark-read" t-on-click="() => this.markNotificationsRead()">
                                    Mark as read
                                </span>
                            </div>
                            <div class="notification-list">
                                <t t-if="!this.state.notifications.length">
                                    <div class="empty-notification">No new orders</div>
                                </t>
                                <t t-foreach="this.state.notifications" t-as="n" t-key="n[0]">
                                    <div class="notification-item">
                                        <span class="order-ref">
                                            <t t-out="n[1]"/>
                                        </span>
                                        <span class="order-amount">
                                            <t t-out="this.state.currency.symbol"/> <t t-out="n[2]"/>
                                        </span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- DARK MODE TOGGLE -->
                    <button class="icon-action-btn" title="Toggle Theme" t-on-click="() => this.toggleTheme()">
                        <t t-if="this.state.dark_mode">
                            <i class="oi sun-icon" data-icon="light_mode"/>
                        </t>
                        <t t-else="">
                            <i class="oi moon-icon" data-icon="dark_mode"/>
                        </t>
                    </button>
                </div>
            </div>

            <!-- ================= FILTER TOOLBAR ================= -->
            <div class="filter-toolbar">
                <div class="filter-pills">
                    <button t-on-click="(ev) => this.changeFilter(ev)"
                            data-filter="today"
                            t-att-class="'filter-btn ' + (this.state.filter === 'today' ? 'active' : '')">
                        Today
                    </button>
                    <button t-on-click="(ev) => this.changeFilter(ev)"
                            data-filter="yesterday"
                            t-att-class="'filter-btn ' + (this.state.filter === 'yesterday' ? 'active' : '')">
                        Yesterday
                    </button>
                    <button t-on-click="(ev) => this.changeFilter(ev)"
                            data-filter="week"
                            t-att-class="'filter-btn ' + (this.state.filter === 'week' ? 'active' : '')">
                        Last 7 Days
                    </button>
                    <button t-on-click="(ev) => this.changeFilter(ev)"
                            data-filter="month"
                            t-att-class="'filter-btn ' + (this.state.filter === 'month' ? 'active' : '')">
                        This Month
                    </button>
                    <button t-on-click="(ev) => this.changeFilter(ev)"
                            data-filter="year"
                            t-att-class="'filter-btn ' + (this.state.filter === 'year' ? 'active' : '')">
                        This Year
                    </button>
                </div>

                <div class="custom-date-filter">
                    <i class="oi date-icon" data-icon="schedule"/>
                    <span class="date-label">From</span>
                    <input type="date" class="date-input"
                           t-att-value="this.state.custom_date_from"
                           t-on-change="(ev) => this.onCustomDateFromChange(ev)"/>
                    <span class="date-label">To</span>
                    <input type="date" class="date-input"
                           t-att-value="this.state.custom_date_to"
                           t-on-change="(ev) => this.onCustomDateToChange(ev)"/>
                    <button t-on-click="(ev) => this.changeFilter(ev)"
                            data-filter="custom"
                            t-att-class="'filter-btn apply-btn ' + (this.state.filter === 'custom' ? 'active' : '')">
                        Apply
                    </button>
                </div>
            </div>

            <!-- ================= KPI CARDS ================= -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Total Sales</span>
                        <div class="kpi-icon kpi-icon-blue">
                            <i class="oi" data-icon="payments"/>
                        </div>
                    </div>
                    <div class="kpi-value">
                        <t t-out="this.state.currency.symbol"/> <t t-out="this.state.sales"/>
                    </div>
                    <div class="kpi-sub">
                        <span t-att-class="'growth-pill ' + (this.state.sales_growth &gt;= 0 ? 'growth-up' : 'growth-down')">
                            <i class="oi" t-att-data-icon="this.state.sales_growth &gt;= 0 ? 'trending_up' : 'trending_down'"/>
                            <t t-out="(this.state.sales_growth &gt;= 0 ? '+' : '') + this.state.sales_growth + '%'"/>
                        </span>
                        <span class="kpi-muted">vs previous period</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Top Product</span>
                        <div class="kpi-icon kpi-icon-green">
                            <i class="oi" data-icon="inventory_2"/>
                        </div>
                    </div>
                    <div class="kpi-value kpi-value-truncate">
                        <t t-if="this.state.products.length">
                            <t t-out="this.state.products[0][0]"/>
                        </t>
                        <t t-else="">-</t>
                    </div>
                    <div class="kpi-sub">
                        <span class="kpi-muted">
                            <t t-if="this.state.products.length">
                                <t t-out="this.state.products[0][1]"/> units sold
                            </t>
                            <t t-else="">No sales yet</t>
                        </span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Active Stores</span>
                        <div class="kpi-icon kpi-icon-amber">
                            <i class="oi" data-icon="storefront"/>
                        </div>
                    </div>
                    <div class="kpi-value">
                        <t t-out="this.state.stores.length"/>
                    </div>
                    <div class="kpi-sub">
                        <span class="kpi-muted">
                            <t t-out="this.state.open_sessions"/> open session(s)
                        </span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Total Orders</span>
                        <div class="kpi-icon kpi-icon-purple">
                            <i class="oi" data-icon="shopping_bag"/>
                        </div>
                    </div>
                    <div class="kpi-value">
                        <t t-out="this.state.total_order_count"/>
                    </div>
                    <div class="kpi-sub">
                        <span class="kpi-muted">Avg Basket:</span>
                        <strong><t t-out="this.state.currency.symbol"/> <t t-out="this.state.avg_order_value"/></strong>
                    </div>
                </div>
            </div>

            <!-- ================= DATA GRID ================= -->
            <div class="data-grid">

                <!-- SALES TREND LINE CHART -->
                <div class="data-card">
                    <div class="card-header-row">
                        <div class="card-title-group">
                            <span class="card-icon icon-green">
                                <i class="oi" data-icon="show_chart"/>
                            </span>
                            <span class="data-title">
                                Sales Trend (<t t-out="(this.state.filter === 'today' or this.state.filter === 'yesterday') ? 'Hourly' : 'Daily'"/>)
                            </span>
                        </div>
                    </div>
                    <div t-if="!this.state.sales_trend.length" class="empty-card-state">
                        <i class="oi" data-icon="show_chart"/>
                        <span>No sales trend data for this period</span>
                    </div>
                    <div t-att-class="'product-chart-container ' + (!this.state.sales_trend.length ? 'd-none' : '')">
                        <canvas id="salesTrendChart"/>
                    </div>
                </div>

                <!-- POS SESSIONS -->
                <div class="data-card">
                    <div class="card-header-row">
                        <div class="card-title-group">
                            <span class="card-icon icon-blue">
                                <i class="oi" data-icon="storefront"/>
                            </span>
                            <span class="data-title">POS Sessions</span>
                        </div>
                    </div>
                    <t t-if="!this.state.sessions.length">
                        <div class="empty-card-state">
                            <i class="oi" data-icon="storefront"/>
                            <span>No POS sessions found</span>
                        </div>
                    </t>
                    <t t-else="">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Session</th>
                                    <th>Cashier</th>
                                    <th>Store</th>
                                    <th>Status</th>
                                    <th>Opened</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.sessions.slice(0,5)" t-as="s" t-key="s.id">
                                    <tr>
                                        <td class="fw-medium"><t t-out="s.name"/></td>
                                        <td><t t-out="s.user"/></td>
                                        <td><t t-out="s.config"/></td>
                                        <td>
                                            <span t-att-class="'status-pill ' + (s.state === 'opened' ? 'status-open' : 'status-closed')">
                                                <t t-out="s.state === 'opened' ? 'Open' : 'Closed'"/>
                                            </span>
                                        </td>
                                        <td class="text-muted-cell"><t t-out="s.start_at"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="session-more" t-if="this.state.sessions.length &gt; 5">
                            <button class="more-btn" t-on-click="() => this.openSessionPopup()">
                                View More (<t t-out="this.state.sessions.length - 5"/>)
                            </button>
                        </div>
                    </t>
                </div>

                <!-- STORE SALES COMPARISON -->
                <t t-if="this.state.filter === 'month' or this.state.filter === 'year'">
                    <div class="data-card">
                        <div class="card-header-row">
                            <div class="card-title-group">
                                <span class="card-icon icon-purple">
                                    <i class="oi" data-icon="stacked_bar_chart"/>
                                </span>
                                <span class="data-title">Store Sales Comparison</span>
                            </div>
                        </div>
                        <div t-if="!this.state.store_comparison.length" class="empty-card-state">
                            <i class="oi" data-icon="stacked_bar_chart"/>
                            <span>No store comparison data available</span>
                        </div>
                        <div t-att-class="'product-chart-container ' + (!this.state.store_comparison.length ? 'd-none' : '')">
                            <canvas id="storeComparisonChart"/>
                        </div>
                    </div>
                </t>

                <!-- TOP PRODUCTS -->
                <div class="data-card">
                    <div class="card-header-row">
                        <div class="card-title-group">
                            <span class="card-icon icon-amber">
                                <i class="oi" data-icon="shopping_bag"/>
                            </span>
                            <span class="data-title">Top Selling Products</span>
                        </div>
                        <div class="card-controls">
                            <t t-if="!this.state.showProductChart">
                                <div class="search-box">
                                    <i class="oi search-icon" data-icon="search"/>
                                    <input type="text"
                                           class="product-search"
                                           placeholder="Search..."
                                           t-on-input="(ev) => this.onProductSearch(ev)"/>
                                </div>
                            </t>
                            <button class="chart-toggle-btn" title="Toggle Chart / Table" t-on-click="() => this.toggleProductChart()">
                                <t t-if="this.state.showProductChart">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                                        <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                                    </svg>
                                </t>
                                <t t-else="">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                                    </svg>
                                </t>
                            </button>
                        </div>
                    </div>

                    <t t-if="!this.state.showProductChart">
                        <t t-if="!this.state.filtered_products.length">
                            <div class="empty-card-state">
                                <i class="oi" data-icon="shopping_bag"/>
                                <span>No products sold in this period</span>
                            </div>
                        </t>
                        <t t-else="">
                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>History</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="this.state.filtered_products.slice(0,5)" t-as="p" t-key="p[2]">
                                        <tr>
                                            <td class="fw-medium"><t t-out="p[0]"/></td>
                                            <td>
                                                <span class="qty-pill">
                                                    <t t-out="p[1]"/>
                                                </span>
                                            </td>
                                            <td>
                                                <button class="view-btn"
                                                        t-on-click="(ev) => this.openProductDetails(ev)"
                                                        t-att-data-product="p[2]">
                                                    View
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>

                    <t t-if="this.state.showProductChart">
                        <div class="product-chart-container">
                            <canvas id="productChart" title="Bar Chart"/>
                        </div>
                    </t>

                    <t t-if="!this.state.showProductChart">
                        <div class="session-more" t-if="this.state.products.length &gt; 5">
                            <button class="more-btn" t-on-click="() => this.openProductPopup()">
                                View More (<t t-out="this.state.products.length - 5"/>)
                            </button>
                        </div>
                    </t>
                </div>

                <!-- STORE PERFORMANCE -->
                <div class="data-card">
                    <div class="card-header-row">
                        <div class="card-title-group">
                            <span class="card-icon icon-blue">
                                <i class="oi" data-icon="stacked_bar_chart"/>
                            </span>
                            <span class="data-title">Store Performance</span>
                        </div>
                        <button class="chart-toggle-btn" title="Toggle Chart / Table" t-on-click="() => this.toggleStoreChart()">
                            <t t-if="this.state.showStoreChart">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                                    <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                                </svg>
                            </t>
                            <t t-else="">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/>
                                </svg>
                            </t>
                        </button>
                    </div>

                    <t t-if="!this.state.showStoreChart">
                        <t t-if="!this.state.stores.length">
                            <div class="empty-card-state">
                                <i class="oi" data-icon="storefront"/>
                                <span>No store sales in this period</span>
                            </div>
                        </t>
                        <t t-else="">
                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Store</th>
                                        <th>Orders</th>
                                        <th>Sales</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="rank" t-value="1"/>
                                    <t t-foreach="this.state.stores.slice(0,5)" t-as="s" t-key="s[0]">
                                        <tr>
                                            <td><span class="rank-pill"><t t-out="rank"/></span></td>
                                            <td class="fw-medium"><t t-out="s[0]"/></td>
                                            <td><t t-out="s[1]"/> Orders</td>
                                            <td class="sales-value">
                                                <t t-out="this.state.currency.symbol"/> <t t-out="s[2]"/>
                                            </td>
                                        </tr>
                                        <t t-set="rank" t-value="rank + 1"/>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>

                    <t t-if="this.state.showStoreChart">
                        <div class="product-chart-container">
                            <canvas id="storeChart" title="Pie Chart"/>
                        </div>
                    </t>

                    <t t-if="!this.state.showStoreChart">
                        <div class="session-more" t-if="this.state.stores.length &gt; 5">
                            <button class="more-btn" t-on-click="() => this.openStorePopup()">
                                View More (<t t-out="this.state.stores.length - 5"/>)
                            </button>
                        </div>
                    </t>

                    <div class="payment-summary" t-if="this.state.payments.length">
                        <div class="payment-title">Payment Methods</div>
                        <div class="payment-methods">
                            <t t-foreach="this.state.payments" t-as="p" t-key="p[0]">
                                <div class="payment-pill">
                                    <span class="payment-icon">
                                        <i class="oi" data-icon="payments"/>
                                    </span>
                                    <span class="payment-name">
                                        <t t-out="p[0]"/>
                                    </span>
                                    <span class="payment-value">
                                        <t t-out="this.state.currency.symbol"/> <t t-out="p[1]"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- TOP CUSTOMERS -->
                <div class="data-card">
                    <div class="card-header-row">
                        <div class="card-title-group">
                            <span class="card-icon icon-purple">
                                <i class="oi" data-icon="group"/>
                            </span>
                            <span class="data-title">Top Customers</span>
                        </div>
                    </div>
                    <t t-if="!this.state.customers.length">
                        <div class="empty-card-state">
                            <i class="oi" data-icon="group"/>
                            <span>No customer sales in this period</span>
                        </div>
                    </t>
                    <t t-else="">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Sales</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.customers.slice(0,5)" t-as="c" t-key="c[0]">
                                    <tr>
                                        <td>
                                            <div class="person-cell">
                                                <t t-if="c[0]">
                                                    <div class="customer-img-wrapper">
                                                        <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'" class="customer-avatar"/>
                                                        <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'" class="customer-zoom"/>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <div class="walkin-avatar">
                                                        <i class="oi" data-icon="group"/>
                                                    </div>
                                                </t>
                                                <span class="fw-medium"><t t-out="c[1]"/></span>
                                            </div>
                                        </td>
                                        <td class="sales-value">
                                            <t t-out="this.state.currency.symbol"/> <t t-out="c[2]"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="session-more" t-if="this.state.customers.length &gt; 5">
                            <button class="more-btn" t-on-click="() => this.openCustomerPopup()">
                                View More (<t t-out="this.state.customers.length - 5"/>)
                            </button>
                        </div>
                    </t>
                </div>

                <!-- TOP CATEGORIES -->
                <div class="data-card">
                    <div class="card-header-row">
                        <div class="card-title-group">
                            <span class="card-icon icon-green">
                                <i class="oi" data-icon="inventory_2"/>
                            </span>
                            <span class="data-title">Top POS Categories</span>
                        </div>
                    </div>
                    <t t-if="!this.state.categories.length">
                        <div class="empty-card-state">
                            <i class="oi" data-icon="inventory_2"/>
                            <span>No category sales in this period</span>
                        </div>
                    </t>
                    <t t-else="">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Qty</th>
                                    <th>Products</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.categories.slice(0,5)" t-as="cat" t-key="cat.id">
                                    <tr>
                                        <td class="fw-medium"><t t-out="cat.name"/></td>
                                        <td>
                                            <span class="qty-pill">
                                                <t t-out="cat.qty"/>
                                            </span>
                                        </td>
                                        <td>
                                            <button class="view-btn"
                                                    t-on-click="(ev) => this.openCategoryProducts(ev)"
                                                    t-att-data-category="cat.id">
                                                View
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="session-more" t-if="this.state.categories and this.state.categories.length &gt; 5">
                            <button class="more-btn" t-on-click="() => this.openCategoryPopup()">
                                View More (<t t-out="this.state.categories.length - 5"/>)
                            </button>
                        </div>
                    </t>
                </div>

                <!-- TOP CASHIERS -->
                <div class="data-card">
                    <div class="card-header-row">
                        <div class="card-title-group">
                            <span class="card-icon icon-amber">
                                <i class="oi" data-icon="badge"/>
                            </span>
                            <span class="data-title">Top Cashiers</span>
                        </div>
                    </div>
                    <t t-if="!this.state.top_cashiers.length">
                        <div class="empty-card-state">
                            <i class="oi" data-icon="badge"/>
                            <span>No cashier activity in this period</span>
                        </div>
                    </t>
                    <t t-else="">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Cashier</th>
                                    <th>Orders</th>
                                    <th>Sales</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.top_cashiers.slice(0,5)" t-as="c" t-key="c.id">
                                    <tr>
                                        <td><span class="rank-pill"><t t-out="c.rank"/></span></td>
                                        <td>
                                            <div class="person-cell">
                                                <div class="customer-img-wrapper">
                                                    <img t-att-src="'/web/image/' + (c.model || 'hr.employee') + '/' + c.id + '/image_128'" class="customer-avatar"/>
                                                    <img t-att-src="'/web/image/' + (c.model || 'hr.employee') + '/' + c.id + '/image_128'" class="customer-zoom"/>
                                                </div>
                                                <span class="fw-medium"><t t-out="c.name"/></span>
                                            </div>
                                        </td>
                                        <td><t t-out="c.orders"/> Orders</td>
                                        <td class="sales-value">
                                            <t t-out="this.state.currency.symbol"/> <t t-out="c.sales"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="session-more" t-if="this.state.top_cashiers.length &gt; 5">
                            <button class="more-btn" t-on-click="() => this.openCashierPopup()">
                                View More (<t t-out="this.state.top_cashiers.length - 5"/>)
                            </button>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ================= POPUPS ================= -->
            <t t-if="this.state.showProductPopup">
                <div class="session-popup-overlay" t-on-click="() => this.closeProductPopup()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>All Top Selling Products</span>
                            <button class="popup-close" t-on-click="() => this.closeProductPopup()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.products.slice(5)" t-as="p" t-key="p[2]">
                                    <tr>
                                        <td><t t-out="p[0]"/></td>
                                        <td><span class="qty-pill"><t t-out="p[1]"/></span></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="this.state.showSessionPopup">
                <div class="session-popup-overlay" t-on-click="() => this.closeSessionPopup()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>All POS Sessions</span>
                            <button class="popup-close" t-on-click="() => this.closeSessionPopup()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Session</th>
                                    <th>Cashier</th>
                                    <th>Store</th>
                                    <th>Status</th>
                                    <th>Opened</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.sessions.slice(5)" t-as="s" t-key="s.id">
                                    <tr>
                                        <td><t t-out="s.name"/></td>
                                        <td><t t-out="s.user"/></td>
                                        <td><t t-out="s.config"/></td>
                                        <td>
                                            <span t-att-class="'status-pill ' + (s.state === 'opened' ? 'status-open' : 'status-closed')">
                                                <t t-out="s.state === 'opened' ? 'Open' : 'Closed'"/>
                                            </span>
                                        </td>
                                        <td><t t-out="s.start_at"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="this.state.showProductDetails">
                <div class="session-popup-overlay" t-on-click="() => this.closeProductDetails()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>Product Sales Details</span>
                            <button class="popup-close" t-on-click="() => this.closeProductDetails()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Date</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.product_details" t-as="d" t-key="d.id">
                                    <tr>
                                        <td><t t-out="d.order"/></td>
                                        <td><t t-out="d.date"/></td>
                                        <td><t t-out="d.qty"/></td>
                                        <td><t t-out="this.state.currency.symbol"/> <t t-out="d.price"/></td>
                                        <td class="sales-value"><t t-out="this.state.currency.symbol"/> <t t-out="d.total"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="this.state.showStorePopup">
                <div class="session-popup-overlay" t-on-click="() => this.closeStorePopup()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>All Store Performance</span>
                            <button class="popup-close" t-on-click="() => this.closeStorePopup()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Store</th>
                                    <th>Orders</th>
                                    <th>Sales</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="rank" t-value="6"/>
                                <t t-foreach="this.state.stores.slice(5)" t-as="s" t-key="s[0]">
                                    <tr>
                                        <td><span class="rank-pill"><t t-out="rank"/></span></td>
                                        <td><t t-out="s[0]"/></td>
                                        <td><t t-out="s[1]"/> Orders</td>
                                        <td class="sales-value"><t t-out="this.state.currency.symbol"/> <t t-out="s[2]"/></td>
                                    </tr>
                                    <t t-set="rank" t-value="rank + 1"/>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="this.state.showCategoryPopup">
                <div class="session-popup-overlay" t-on-click="() => this.closeCategoryPopup()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>Top Categories</span>
                            <button class="popup-close" t-on-click="() => this.closeCategoryPopup()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.categories.slice(5)" t-as="cat" t-key="cat.id">
                                    <tr>
                                        <td><t t-out="cat.name"/></td>
                                        <td><span class="qty-pill"><t t-out="cat.qty"/></span></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="this.state.showCategoryProducts">
                <div class="session-popup-overlay" t-on-click="() => this.closeCategoryProducts()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>Category Products</span>
                            <button class="popup-close" t-on-click="() => this.closeCategoryProducts()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.category_products" t-as="p" t-key="p.id">
                                    <tr>
                                        <td><t t-out="p.name"/></td>
                                        <td><span class="qty-pill"><t t-out="p.qty"/></span></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="this.state.showCustomerPopup">
                <div class="session-popup-overlay" t-on-click="() => this.closeCustomerPopup()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>Top Customers</span>
                            <button class="popup-close" t-on-click="() => this.closeCustomerPopup()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Sales</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.customers.slice(5)" t-as="c" t-key="c[0]">
                                    <tr>
                                        <td>
                                            <div class="person-cell">
                                                <t t-if="c[0]">
                                                    <div class="customer-img-wrapper">
                                                        <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'" class="customer-avatar"/>
                                                        <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'" class="customer-zoom"/>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <div class="walkin-avatar">
                                                        <i class="oi" data-icon="group"/>
                                                    </div>
                                                </t>
                                                <span><t t-out="c[1]"/></span>
                                            </div>
                                        </td>
                                        <td class="sales-value"><t t-out="this.state.currency.symbol"/> <t t-out="c[2]"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

            <t t-if="this.state.showCashierPopup">
                <div class="session-popup-overlay" t-on-click="() => this.closeCashierPopup()">
                    <div class="session-popup" t-on-click.stop="">
                        <div class="popup-header">
                            <span>Top Cashiers</span>
                            <button class="popup-close" t-on-click="() => this.closeCashierPopup()">✕</button>
                        </div>
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Cashier</th>
                                    <th>Orders</th>
                                    <th>Sales</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="this.state.top_cashiers.slice(5)" t-as="c" t-key="c.id">
                                    <tr>
                                        <td><span class="rank-pill"><t t-out="c.rank"/></span></td>
                                        <td><t t-out="c.name"/></td>
                                        <td><t t-out="c.orders"/></td>
                                        <td class="sales-value"><t t-out="this.state.currency.symbol"/> <t t-out="c.sales"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>